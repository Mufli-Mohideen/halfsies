# Public URL of the production site. Used for canonical and Open Graph tags.
# (Share links use the current origin, so preview deploys and localhost work without changing this.)
# Replace before launch — see LAUNCH.md → Domain.
VITE_SITE_URL=https://halfsies.app

# Optional analytics sink: any endpoint that accepts POSTed JSON via sendBeacon.
# Leave empty to send nothing. The game never depends on it.
VITE_ANALYTICS_ENDPOINT=
